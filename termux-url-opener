#!/data/data/com.termux/files/usr/bin/bash
# termux-url-opener — append shared URLs/text to today's Logseq journal
#
# Termux calls this script with the shared URL as $1 whenever you share
# anything to Termux from another app.
#
# Install: symlinked to ~/bin/termux-url-opener by termux_setup.sh

LOG="$HOME/.local/share/nvim/termux-url-opener.log"
mkdir -p "$(dirname "$LOG")"
notify() { termux-notification --title "Journal" --content "$1" 2>/dev/null; }
log()    { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" | tee -a "$LOG" >&2; }

URL="$1"
if [ -z "$URL" ]; then
  log "ERROR: called with no argument"
  notify "Journal: no URL received"
  exit 1
fi
log "Received: $URL"

# ── Resolve vault path ────────────────────────────────────────────────────────
VAULT_PATH_FILE="$HOME/.local/share/nvim/logseq_vault"
if [ ! -f "$VAULT_PATH_FILE" ]; then
  log "ERROR: vault path file not found: $VAULT_PATH_FILE"
  notify "Journal: vault not configured (run termux_setup.sh)"
  exit 1
fi

VAULT=$(cat "$VAULT_PATH_FILE")
if [ -z "$VAULT" ]; then
  log "ERROR: vault path file is empty"
  notify "Journal: vault path is empty"
  exit 1
fi
log "Vault: $VAULT"

# ── Today's journal file (matches journal_format = "%Y_%m_%d") ────────────────
JOURNAL_DIR="$VAULT/journals"
mkdir -p "$JOURNAL_DIR"
TODAY=$(date +%Y_%m_%d)
JOURNAL="$JOURNAL_DIR/${TODAY}.md"

# ── Append entry ──────────────────────────────────────────────────────────────
# Ensure file ends with a newline before appending.
# wc -l counts the newline in the last byte: 1 = ends with \n, 0 = does not.
if [ -f "$JOURNAL" ] && [ -s "$JOURNAL" ]; then
  if [ "$(tail -c 1 "$JOURNAL" | wc -l)" -eq 0 ]; then
    printf '\n' >> "$JOURNAL"
  fi
fi

printf '- %s\n' "$URL" >> "$JOURNAL"
log "Appended to $JOURNAL"
notify "Added to journal: $TODAY"
