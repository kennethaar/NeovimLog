#!/data/data/com.termux/files/usr/bin/bash
# termux-url-opener — share URLs or text to today's Logseq journal
#
# Writes to an inbox file; Neovim flushes it into the buffer on FocusGained
# when the user switches back. No second Neovim process needed.

set -euo pipefail

LOG="$HOME/.local/share/nvim/termux-url-opener.log"
INBOX="$HOME/.local/share/nvim/journal_inbox.md"
mkdir -p "$(dirname "$LOG")"

log()    { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG"; }
notify() { termux-notification --title "Journal" --content "$1" 2>/dev/null || true; }

INPUT="${1:-}"
if [ -z "$INPUT" ]; then
  log "ERROR: called with no argument"
  notify "Journal: nothing received"
  exit 1
fi

printf -- '- %s\n' "$INPUT" >> "$INBOX"
log "Inbox: $INPUT"
notify "Added to journal: $(printf '%s' "$INPUT" | cut -c1-60)"
