#!/data/data/com.termux/files/usr/bin/bash
# termux-url-opener — append shared URLs to today's Logseq journal
#
# Termux calls this script with the shared URL as $1 whenever you share
# anything to Termux from another app.
#
# Install: symlinked to ~/bin/termux-url-opener by termux_setup.sh

set -euo pipefail

URL="${1:-}"
if [ -z "$URL" ]; then
  termux-notification --title "Journal" --content "No URL received." 2>/dev/null || true
  exit 1
fi

# ── Resolve vault path ────────────────────────────────────────────────────────
VAULT_PATH_FILE="$HOME/.local/share/nvim/logseq_vault"
if [ ! -f "$VAULT_PATH_FILE" ]; then
  termux-notification --title "Journal" --content "Vault not configured. Run termux_setup.sh first." 2>/dev/null || true
  exit 1
fi

VAULT=$(cat "$VAULT_PATH_FILE")
JOURNAL_DIR="$VAULT/journals"
mkdir -p "$JOURNAL_DIR"

# ── Today's journal file (matches journal_format = "%Y_%m_%d") ────────────────
TODAY=$(date +%Y_%m_%d)
JOURNAL="$JOURNAL_DIR/${TODAY}.md"

# ── Append entry ──────────────────────────────────────────────────────────────
# Ensure file ends with a newline before appending
if [ -f "$JOURNAL" ] && [ -s "$JOURNAL" ]; then
  LAST=$(tail -c 1 "$JOURNAL" | wc -l)
  if [ "$LAST" -eq 0 ]; then
    printf '\n' >> "$JOURNAL"
  fi
fi

printf -- '- %s\n' "$URL" >> "$JOURNAL"

termux-notification --title "Journal" --content "Added to $TODAY" 2>/dev/null || true
