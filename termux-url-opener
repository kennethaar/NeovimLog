#!/data/data/com.termux/files/usr/bin/bash
# termux-url-opener — queue shared URLs/text for Neovim to insert into the journal
#
# Termux calls this script with the shared URL as $1 whenever you share
# anything to Termux from another app.
#
# Writes to an inbox file that Neovim merges into the journal buffer on next
# focus, avoiding the race where Neovim's autosave overwrites external appends.
#
# Install: symlinked to ~/bin/termux-url-opener by termux_setup.sh

LOG="$HOME/.local/share/nvim/termux-url-opener.log"
mkdir -p "$(dirname "$LOG")"
notify() { termux-notification --title "Journal" --content "$1" 2>/dev/null; }
log()    { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" | tee -a "$LOG" >&2; }

URL="$1"
if [ -z "$URL" ]; then
  log "ERROR: called with no argument"
  notify "Journal: no URL received"
  exit 1
fi
log "Received: $URL"

# ── Write to inbox (Neovim merges this into the journal buffer) ───────────────
INBOX="$HOME/.local/share/nvim/journal_inbox.md"
printf '- %s\n' "$URL" >> "$INBOX"
log "Queued to inbox: $INBOX"
notify "Queued for journal: $(basename "$URL" | cut -c1-60)"
